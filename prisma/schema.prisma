generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Categoria {
  id       Int       @id @default(autoincrement())
  nome     String
}

model Produto {
  id          Int       @id @default(autoincrement())
  nome        String
  preco       Float
  disponivel  Boolean   @default(true)
}